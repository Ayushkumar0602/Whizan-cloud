# =============================================================================
# Whizan Cloud Service — Production Environment Template
# Copy to /opt/whizan/.env.production on your DigitalOcean Droplet
# and fill in all the values.
# =============================================================================

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Get from: Supabase → Settings → Database → URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Get from: Upstash → Database → Details → Redis URL
# Important: Use the rediss:// (TLS) URL, NOT redis://
REDIS_URL="rediss://default:[YOUR-TOKEN]@[YOUR-ENDPOINT].upstash.io:6379"

# ─── Auth Secrets ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX"
COOKIE_SECRET="REPLACE_WITH_64_CHAR_HEX"

# ─── Encryption (for env vars stored in DB) ────────────────────────────────────
# Generate: openssl rand -hex 32  (MUST be exactly 64 hex chars)
ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX"

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create at: github.com → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# This must match the callback URL in your GitHub OAuth App exactly:
GITHUB_CALLBACK_URL="https://api.whizan.cloud/api/auth/github/callback"

# ─── App URLs ─────────────────────────────────────────────────────────────────
API_PORT=8000
# Your production dashboard URL (so the API CORS allows it):
DASHBOARD_URL="https://dashboard.whizan.cloud"
# The Edge Router runs on port 80 of the Droplet/VM:
ROUTER_PORT=80
# Use whizan.cloud for wildcard DNS: <slug>.whizan.cloud
BASE_DOMAIN="whizan.cloud"

# ─── Build Worker ──────────────────────────────────────────────────────────────
# IMPORTANT: Use /opt/whizan-builds (not /tmp) so builds survive reboots!
BUILD_BASE_DIR="/opt/whizan-builds"

NODE_ENV="production"
