// This is your Prisma schema file.
// Run: npm run db:generate to generate the client
// Run: npm run db:migrate to apply migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
//  USERS
// ─────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")   // null for GitHub-only users
  githubId     String?   @unique @map("github_id")
  githubToken  String?   @map("github_token")     // encrypted
  name         String?
  avatarUrl    String?   @map("avatar_url")
  subscriptionTier String @default("HOBBY") @map("subscription_tier") // HOBBY | PROFESSIONAL
  role         String    @default("USER") // ROOT_ADMIN | ADMIN | DEVOPS_ADMIN | SUPPORT_ADMIN | USER
  iamPermissions String? @default("all") @map("iam_permissions") // Comma-separated permissions or "all"
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projects         Project[]
  backendServices  BackendService[]
  databaseServices DatabaseService[]
  refreshTokens    RefreshToken[]
  apiKeys          ApiKey[]
  functionServices FunctionService[]
  cronJobs         CronJob[]
  workflows        Workflow[]
  agentSessions    AgentSession[]

  @@map("users")
}

// ─────────────────────────────────────────
//  API KEYS (FOR IDE MCP / CLI ACCESS)
// ─────────────────────────────────────────
model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String    @default("IDE MCP Key")
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix") // e.g. "whz_live_a1b2..."
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ─────────────────────────────────────────
//  REFRESH TOKENS
// ─────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
//  PROJECTS
// ─────────────────────────────────────────
model Project {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  name           String
  slug           String    @unique   // used for <slug>.localhost subdomain
  githubRepoUrl  String    @default("") @map("github_repo_url")
  githubRepoId   String?   @map("github_repo_id")
  webhookSecret  String    @map("webhook_secret")  // HMAC secret for this project
  branch         String    @default("main")
  rootDir        String    @default(".") @map("root_dir")
  buildCommand   String    @default("npm run build") @map("build_command")
  installCommand String    @default("npm install") @map("install_command")
  outputDir      String    @default(".next") @map("output_dir")
  framework      Framework @default(NEXTJS)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments    Deployment[]
  envVariables   EnvVariable[]
  customDomains  CustomDomain[]
  analytics      ProjectAnalytics[]

  @@map("projects")
}

enum Framework {
  NEXTJS
  REACT
  VITE
  ASTRO
  CUSTOM

  @@map("framework")
}

// ─────────────────────────────────────────
//  DEPLOYMENTS
// ─────────────────────────────────────────
model Deployment {
  id               String           @id @default(uuid())
  projectId        String           @map("project_id")
  commitHash       String           @map("commit_hash")
  commitMessage    String?          @map("commit_message")
  branch           String
  status           DeploymentStatus @default(QUEUED)
  deploymentType   DeploymentType?  @map("deployment_type")
  uploadType       String?          @default("git") @map("upload_type") // "git" or "direct"
  url              String?          // e.g. my-app.localhost
  containerPort    Int?             @map("container_port")  // for SSR/hybrid apps
  buildStartedAt   DateTime?        @map("build_started_at")
  buildFinishedAt  DateTime?        @map("build_finished_at")
  errorMessage     String?          @map("error_message")
  createdAt        DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("deployments")
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  READY
  FAILED
  CANCELLED
  PAUSED

  @@map("deployment_status")
}

enum DeploymentType {
  STATIC
  SSR
  HYBRID

  @@map("deployment_type")
}

// ─────────────────────────────────────────
//  ENV VARIABLES (ENCRYPTED)
// ─────────────────────────────────────────
model EnvVariable {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  key       String
  value     String   // AES-256-GCM encrypted ciphertext
  isSecret  Boolean  @default(true) @map("is_secret")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("env_variables")
}

// ─────────────────────────────────────────
//  CUSTOM DOMAINS
// ─────────────────────────────────────────
model CustomDomain {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  domain    String    @unique
  verified  Boolean   @default(false)
  sslStatus String    @default("pending") @map("ssl_status")
  createdAt DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("custom_domains")
}

// ─────────────────────────────────────────
//  PROJECT ANALYTICS (Aggregated daily)
// ─────────────────────────────────────────
model ProjectAnalytics {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  date      DateTime @db.Date  // e.g. 2026-09-26
  pageViews Int      @default(0) @map("page_views")
  visitors  Int      @default(0)
  bandwidth Int      @default(0) // in bytes
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@map("project_analytics")
}


// ─────────────────────────────────────────
//  BACKEND SERVICES (Independent from Projects)
// ─────────────────────────────────────────
model BackendService {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  name           String
  slug           String          @unique   // e.g. api-service.localhost
  githubRepoUrl  String          @default("") @map("github_repo_url")
  branch         String          @default("main")
  language       BackendLanguage @default(NODEJS)
  rootDir        String          @default(".") @map("root_dir")
  installCommand String          @default("npm install") @map("install_command")
  startCommand   String          @default("npm start") @map("start_command")
  internalPort   Int             @default(8000) @map("internal_port")
  isPublic       Boolean         @default(false) @map("is_public") // If false, only reachable via internal Docker network
  autoSleep      Boolean         @default(true) @map("auto_sleep")
  instanceType   String          @default("free") @map("instance_type") // "free" (if autoSleep), "starter", "standard", "pro", "pro_plus"
  cpuLimit       Float           @default(0.1) @map("cpu_limit")           // vCPUs (e.g. 0.1 for free/spin down, 0.5, 1.0, 2.0, 4.0)
  memoryLimit    Int             @default(512) @map("memory_limit")        // RAM in MB (e.g. 512, 1024, 2048, 4096)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments    ServiceDeployment[]
  envVariables   ServiceEnvVariable[]

  @@map("backend_services")
}

enum BackendLanguage {
  NODEJS
  PYTHON
  GO
  DOCKERFILE

  @@map("backend_language")
}

// ─────────────────────────────────────────
//  SERVICE DEPLOYMENTS
// ─────────────────────────────────────────
model ServiceDeployment {
  id               String           @id @default(uuid())
  serviceId        String           @map("service_id")
  commitHash       String           @map("commit_hash")
  commitMessage    String?          @map("commit_message")
  branch           String
  status           DeploymentStatus @default(QUEUED)
  uploadType       String?          @default("git") @map("upload_type") // "git" or "direct"
  containerPort    Int?             @map("container_port")  // Mapped host port
  buildStartedAt   DateTime?        @map("build_started_at")
  buildFinishedAt  DateTime?        @map("build_finished_at")
  errorMessage     String?          @map("error_message")
  createdAt        DateTime         @default(now()) @map("created_at")

  service BackendService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt(sort: Desc)])
  @@map("service_deployments")
}

// ─────────────────────────────────────────
//  SERVICE ENV VARIABLES
// ─────────────────────────────────────────
model ServiceEnvVariable {
  id        String   @id @default(uuid())
  serviceId String   @map("service_id")
  key       String
  value     String   // AES-256-GCM encrypted ciphertext
  isSecret  Boolean  @default(true) @map("is_secret")
  createdAt DateTime @default(now()) @map("created_at")

  service BackendService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
  @@map("service_env_variables")
}

// ─────────────────────────────────────────
//  MANAGED DATABASE SERVICES
// ─────────────────────────────────────────
model DatabaseService {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  name         String
  slug         String         @unique // unique DNS hostname in internal Docker network (e.g. "my-postgres")
  type         DatabaseType   @default(POSTGRESQL)
  version      String         @default("16")
  status       DatabaseStatus @default(PROVISIONING)
  databaseName String         @default("whizan_db") @map("database_name")
  username     String         @default("whizan_user")
  password     String         // AES-256-GCM encrypted
  internalPort Int            @default(5432) @map("internal_port")
  externalPort Int?           @map("external_port") // Host port for external access (e.g. 15432)
  volumePath   String         @map("volume_path")   // Host disk path for persistent data
  instanceType String         @default("starter") @map("instance_type") // starter, standard, pro
  cpuLimit     Float          @default(0.5) @map("cpu_limit")           // vCPUs (e.g. 0.5, 1.0, 2.0)
  memoryLimit  Int            @default(512) @map("memory_limit")        // RAM in MB (e.g. 512, 1024, 2048)
  poolerPort   Int?           @map("pooler_port")                       // External host port for PgBouncer pooler (e.g. 16543)
  enablePooler Boolean        @default(true) @map("enable_pooler")
  ipWhitelist  String[]       @default([]) @map("ip_whitelist")          // Allowed CIDR / IP addresses
  sslEnabled   Boolean        @default(true) @map("ssl_enabled")
  readonlyPassword String?    @map("readonly_password")                 // AES-256-GCM encrypted for read-only user
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("database_services")
}

enum DatabaseType {
  POSTGRESQL
  REDIS
  MYSQL

  @@map("database_type")
}

enum DatabaseStatus {
  PROVISIONING
  RUNNING
  STOPPED
  RESTARTING
  FAILED

  @@map("database_status")
}

// ─────────────────────────────────────────
//  FUNCTION SERVICES (EDGE / SERVERLESS BACKEND)
// ─────────────────────────────────────────
model FunctionService {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  name           String
  slug           String            @unique // e.g. "payment-api" -> payment-api.fn.whizan.cloud
  runtime        FunctionRuntime   @default(EDGE_TYPESCRIPT)
  entryFile      String            @default("index.ts") @map("entry_file")
  timeoutMs      Int               @default(10000) @map("timeout_ms")
  memoryLimit    Int               @default(128) @map("memory_limit") // RAM in MB (128, 256, 512, 1024)
  minInstances   Int               @default(0) @map("min_instances")   // 0 = scale-to-zero, 1+ = keep warm
  maxConcurrency Int               @default(10) @map("max_concurrency")
  isPublic       Boolean           @default(false) @map("is_public")   // false = requires Function API Key
  corsOrigins    String[]          @default(["*"]) @map("cors_origins")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys        FunctionApiKey[]
  endpoints      FunctionEndpoint[]
  deployments    FunctionDeployment[]
  envVariables   FunctionEnvVariable[]
  triggers       FunctionTrigger[]
  invocations    FunctionInvocation[]

  @@map("function_services")
}

enum FunctionRuntime {
  EDGE_TYPESCRIPT
  NODEJS_20
  PYTHON_311
  GOLANG_122

  @@map("function_runtime")
}

// ─────────────────────────────────────────
//  FUNCTION API KEYS
// ─────────────────────────────────────────
model FunctionApiKey {
  id           String    @id @default(uuid())
  serviceId    String    @map("service_id")
  name         String    @default("Production Key")
  keyHash      String    @unique @map("key_hash") // SHA-256 hash of plaintext key
  keyPrefix    String    @map("key_prefix")       // e.g. "whz_fn_live_a1b2..."
  keyCipher    String?   @map("key_cipher")       // AES-256-GCM encrypted key for authorized retrieval
  scopes       String[]  @default(["EXECUTE"])    // EXECUTE | READ_LOGS | ADMIN
  rateLimitRpm Int       @default(600) @map("rate_limit_rpm") // Requests per minute
  ipWhitelist  String[]  @default([]) @map("ip_whitelist")
  expiresAt    DateTime? @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  service      FunctionService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("function_api_keys")
}

// ─────────────────────────────────────────
//  FUNCTION ENDPOINTS
// ─────────────────────────────────────────
model FunctionEndpoint {
  id          String   @id @default(uuid())
  serviceId   String   @map("service_id")
  name        String   // e.g. "charge", "webhook"
  routePath   String   @map("route_path") // e.g. "/", "/charge", "/users/:id"
  httpMethods String[] @default(["GET", "POST"]) @map("http_methods")
  handlerName String   @default("default") @map("handler_name")
  isPublic    Boolean  @default(false) @map("is_public")
  cacheTtlSec Int      @default(0) @map("cache_ttl_sec") // 0 = no cache, >0 = Edge Redis cache
  createdAt   DateTime @default(now()) @map("created_at")

  service     FunctionService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, routePath])
  @@map("function_endpoints")
}

// ─────────────────────────────────────────
//  FUNCTION DEPLOYMENTS
// ─────────────────────────────────────────
model FunctionDeployment {
  id              String           @id @default(uuid())
  serviceId       String           @map("service_id")
  version         Int              @default(1)
  bundlePath      String           @map("bundle_path") // Absolute path to compiled ESM bundle
  bundleHash      String           @map("bundle_hash") // SHA-256 integrity hash
  bundleSizeBytes Int              @map("bundle_size_bytes")
  status          DeploymentStatus @default(READY)
  trafficWeight   Int              @default(100) @map("traffic_weight")
  errorMessage    String?          @map("error_message")
  sourceCode      String?          @map("source_code") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")

  service         FunctionService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt(sort: Desc)])
  @@map("function_deployments")
}

// ─────────────────────────────────────────
//  FUNCTION TRIGGERS
// ─────────────────────────────────────────
model FunctionTrigger {
  id        String      @id @default(uuid())
  serviceId String      @map("service_id")
  type      TriggerType @default(HTTP)
  config    Json        // e.g. { "cron": "0 0 * * *" }
  enabled   Boolean     @default(true)
  lastRunAt DateTime?   @map("last_run_at")
  createdAt DateTime    @default(now()) @map("created_at")

  service   FunctionService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("function_triggers")
}

enum TriggerType {
  HTTP
  CRON
  DATABASE_CDC
  STORAGE_BLOB
  QUEUE_MESSAGE

  @@map("trigger_type")
}

// ─────────────────────────────────────────
//  FUNCTION ENV VARIABLES
// ─────────────────────────────────────────
model FunctionEnvVariable {
  id        String   @id @default(uuid())
  serviceId String   @map("service_id")
  key       String
  value     String   // AES-256-GCM encrypted ciphertext
  isSecret  Boolean  @default(true) @map("is_secret")
  createdAt DateTime @default(now()) @map("created_at")

  service   FunctionService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
  @@map("function_env_variables")
}

// ─────────────────────────────────────────
//  FUNCTION INVOCATIONS (Buffered Telemetry)
// ─────────────────────────────────────────
model FunctionInvocation {
  id         String   @id @default(uuid())
  serviceId  String   @map("service_id")
  endpoint   String
  httpMethod String   @map("http_method")
  statusCode Int      @map("status_code")
  durationMs Float    @map("duration_ms")
  memoryMb   Float    @map("memory_mb")
  clientIp   String   @map("client_ip")
  timestamp  DateTime @default(now())

  service    FunctionService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, timestamp(sort: Desc)])
  @@map("function_invocations")
}

// ─────────────────────────────────────────
//  CRON SCHEDULED JOBS
// ─────────────────────────────────────────
model CronJob {
  id                String              @id @default(uuid())
  userId            String              @map("user_id")
  name              String              // e.g. "Daily Database Vacuum & Backup"
  description       String?             @db.Text
  schedule          String              // Standard 5/6-part cron expression (e.g. "0 0 * * *")
  timezone          String              @default("UTC") // IANA format (e.g. "America/New_York", "Asia/Kolkata")
  
  targetType        CronTargetType      @map("target_type")
  targetConfig      Json                @map("target_config")

  misfirePolicy     CronMisfirePolicy   @default(SKIP) @map("misfire_policy")
  concurrencyPolicy CronConcurrency     @default(FORBID) @map("concurrency_policy")
  maxConcurrentRuns Int                 @default(1) @map("max_concurrent_runs")
  
  timeoutSeconds    Int                 @default(300) @map("timeout_seconds") // 1s to 3600s
  maxRetries        Int                 @default(3) @map("max_retries")
  retryDelaySeconds Int                 @default(10) @map("retry_delay_seconds")
  
  enabled           Boolean             @default(true)
  nextRunAt         DateTime?           @map("next_run_at")
  lastRunAt         DateTime?           @map("last_run_at")
  lastStatus        CronExecutionStatus? @map("last_status")
  
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions        CronExecution[]
  deadLetters       CronDeadLetter[]

  @@index([userId])
  @@index([enabled, nextRunAt])
  @@map("cron_jobs")
}

enum CronTargetType {
  FUNCTION        // Whizan Edge Function
  PROJECT         // Whizan Web Project Route
  SERVICE         // Whizan Backend Service internal mesh endpoint
  CONTAINER_EXEC  // Docker exec command inside existing container
  WEBHOOK         // External HTTPS endpoint with HMAC signature

  @@map("cron_target_type")
}

enum CronMisfirePolicy {
  SKIP             // Drop missed executions during downtime, advance to next
  FIRE_LATEST_ONCE // Fire 1 catchup execution immediately upon boot, then resume
  CATCH_UP_ALL     // Sequentially execute all missed ticks

  @@map("cron_misfire_policy")
}

enum CronConcurrency {
  FORBID           // Skip new execution if previous run is still active
  ALLOW            // Allow overlapping executions up to maxConcurrentRuns
  REPLACE          // Abort running execution and spawn new one
  QUEUE_SERIALIZE  // Enqueue next run to start as soon as active run completes

  @@map("cron_concurrency")
}

enum CronExecutionStatus {
  SCHEDULED
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  SKIPPED_OVERLAP
  MISFIRE_SKIPPED

  @@map("cron_execution_status")
}

// ─────────────────────────────────────────
//  CRON EXECUTION HISTORY (Partitioned Runs)
// ─────────────────────────────────────────
model CronExecution {
  id              String              @id @default(uuid())
  cronJobId       String              @map("cron_job_id")
  triggerType     String              @default("SCHEDULED") @map("trigger_type") // SCHEDULED | MANUAL | RETRY | MISFIRE_CATCHUP
  status          CronExecutionStatus @default(RUNNING)
  
  startedAt       DateTime            @default(now()) @map("started_at")
  finishedAt      DateTime?           @map("finished_at")
  durationMs      Float?              @map("duration_ms")
  
  exitCode        Int?                @map("exit_code")
  httpStatusCode  Int?                @map("http_status_code")
  errorMessage    String?             @map("error_message") @db.Text
  
  // Stdout & Stderr capped ring-buffer
  stdout          String?             @db.Text
  stderr          String?             @db.Text
  
  memoryMbPeak    Float?              @map("memory_mb_peak")
  cpuMs           Float?              @map("cpu_ms")
  retryAttempt    Int                 @default(0) @map("retry_attempt")

  cronJob         CronJob             @relation(fields: [cronJobId], references: [id], onDelete: Cascade)

  @@index([cronJobId, startedAt(sort: Desc)])
  @@map("cron_executions")
}

// ─────────────────────────────────────────
//  CRON DEAD LETTER QUEUE (DLQ)
// ─────────────────────────────────────────
model CronDeadLetter {
  id              String           @id @default(uuid())
  cronJobId       String           @map("cron_job_id")
  executionId     String?          @map("execution_id")
  failureReason   String           @map("failure_reason") @db.Text
  payload         Json?
  retryCount      Int              @default(0) @map("retry_count")
  status          DeadLetterStatus @default(UNRESOLVED)
  createdAt       DateTime         @default(now()) @map("created_at")
  resolvedAt      DateTime?        @map("resolved_at")

  cronJob         CronJob          @relation(fields: [cronJobId], references: [id], onDelete: Cascade)

  @@index([cronJobId, status])
  @@map("cron_dead_letters")
}

enum DeadLetterStatus {
  UNRESOLVED
  REPLAYED
  DISCARDED

  @@map("dead_letter_status")
}

// ─────────────────────────────────────────
//  WORKFLOW AUTOMATION (Whizan Flow Engine)
// ─────────────────────────────────────────
model Workflow {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  projectId         String?              @map("project_id")
  name              String
  description       String?              @db.Text
  slug              String
  
  visualConfig      Json                 @default("{}") @map("visual_config")
  codeDefinition    String               @default("") @db.Text @map("code_definition")
  
  enabled           Boolean              @default(true)
  isTemplate        Boolean              @default(false) @map("is_template")
  category          String               @default("CUSTOM")
  
  concurrencyPolicy WorkflowConcurrency  @default(QUEUE) @map("concurrency_policy")
  maxConcurrentRuns Int                  @default(1) @map("max_concurrent_runs")
  timeoutSeconds    Int                  @default(3600) @map("timeout_seconds")
  
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes             WorkflowNode[]
  edges             WorkflowEdge[]
  triggers          WorkflowTrigger[]
  runs              WorkflowRun[]

  @@unique([userId, slug])
  @@index([userId, enabled])
  @@map("workflows")
}

enum WorkflowConcurrency {
  FORBID
  QUEUE
  ALLOW
  REPLACE

  @@map("workflow_concurrency")
}

model WorkflowNode {
  id              String             @id @default(uuid())
  workflowId      String             @map("workflow_id")
  nodeKey         String             @map("node_key")
  name            String
  type            WorkflowNodeType   @map("type")
  config          Json               @default("{}")
  
  timeoutSeconds  Int                @default(600) @map("timeout_seconds")
  maxRetries      Int                @default(0) @map("max_retries")
  retryDelaySec   Int                @default(5) @map("retry_delay_sec")
  continueOnError Boolean            @default(false) @map("continue_on_error")
  
  positionX       Float              @default(0) @map("position_x")
  positionY       Float              @default(0) @map("position_y")

  workflow        Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns        WorkflowStepRun[]

  @@unique([workflowId, nodeKey])
  @@map("workflow_nodes")
}

enum WorkflowNodeType {
  TRIGGER_GIT
  TRIGGER_CRON
  TRIGGER_WEBHOOK
  TRIGGER_MANUAL
  
  ACTION_WORKSPACE_ANALYZE
  ACTION_BUILD_CONTAINER
  ACTION_DEPLOY_EDGE
  ACTION_DEPLOY_SERVICE
  ACTION_CONTAINER_EXEC
  ACTION_RUN_TESTS
  
  ACTION_HEALTH_PROBE
  ACTION_ROUTER_CUTOVER
  ACTION_AUTO_ROLLBACK
  
  ACTION_V8_FUNCTION
  ACTION_HTTP_REQUEST
  ACTION_DATABASE_QUERY
  ACTION_AI_PROMPT
  ACTION_NOTIFICATION
  
  CONTROL_CONDITION
  CONTROL_PARALLEL
  CONTROL_JOIN
  CONTROL_DELAY
  CONTROL_APPROVAL

  @@map("workflow_node_type")
}

model WorkflowEdge {
  id            String   @id @default(uuid())
  workflowId    String   @map("workflow_id")
  sourceNodeKey String   @map("source_node_key")
  targetNodeKey String   @map("target_node_key")
  condition     String?  @default("SUCCESS")

  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, sourceNodeKey])
  @@map("workflow_edges")
}

model WorkflowTrigger {
  id              String    @id @default(uuid())
  workflowId      String    @map("workflow_id")
  type            String    @default("MANUAL")
  config          Json      @default("{}")
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_triggers")
}

model WorkflowRun {
  id              String            @id @default(uuid())
  workflowId      String            @map("workflow_id")
  triggerSource   String            @default("MANUAL") @map("trigger_source")
  triggerMetadata Json?             @map("trigger_metadata")
  
  status          WorkflowRunStatus @default(PENDING)
  
  startedAt       DateTime          @default(now()) @map("started_at")
  finishedAt      DateTime?         @map("finished_at")
  durationMs      Int?              @map("duration_ms")
  
  contextData     Json              @default("{}") @map("context_data")
  errorMessage    String?           @db.Text @map("error_message")
  triggeredBy     String?           @map("triggered_by")

  workflow        Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns        WorkflowStepRun[]
  approvals       WorkflowApproval[]

  @@index([workflowId, status])
  @@index([startedAt(sort: Desc)])
  @@map("workflow_runs")
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  WAITING_FOR_APPROVAL
  PAUSED
  SUCCESS
  FAILED
  CANCELLED
  TIMED_OUT

  @@map("workflow_run_status")
}

model WorkflowStepRun {
  id              String            @id @default(uuid())
  runId           String            @map("run_id")
  nodeId          String?           @map("node_id")
  nodeKey         String            @map("node_key")
  nodeType        WorkflowNodeType  @map("node_type")
  
  status          WorkflowRunStatus @default(PENDING)
  
  startedAt       DateTime          @default(now()) @map("started_at")
  finishedAt      DateTime?         @map("finished_at")
  durationMs      Int?              @map("duration_ms")
  
  memoizationHash String?           @map("memoization_hash")
  outputData      Json?             @map("output_data")
  exitCode        Int?              @map("exit_code")
  httpStatusCode  Int?              @map("http_status_code")
  
  stdout          String?           @db.Text
  stderr          String?           @db.Text
  
  retryAttempt    Int               @default(0) @map("retry_attempt")
  errorMessage    String?           @db.Text @map("error_message")

  workflowRun     WorkflowRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  node            WorkflowNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@unique([runId, nodeKey])
  @@index([runId, status])
  @@map("workflow_step_runs")
}

model WorkflowApproval {
  id            String         @id @default(uuid())
  runId         String         @map("run_id")
  nodeKey       String         @map("node_key")
  
  title         String
  description   String?        @db.Text
  
  status        ApprovalStatus @default(PENDING)
  approvalToken String         @unique @map("approval_token")
  
  approvedBy    String?        @map("approved_by")
  comments      String?        @db.Text
  
  expiresAt     DateTime       @map("expires_at")
  respondedAt   DateTime?      @map("responded_at")

  workflowRun   WorkflowRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@map("workflow_approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("approval_status")
}

// ─────────────────────────────────────────
//  SUMMER: BROWSER COPILOT AGENT SESSIONS
// ─────────────────────────────────────────
model AgentSession {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  title     String         @default("New Conversation")
  context   Json?          // Current page route, focused project/service ID
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  actions   AgentAction[]

  @@map("agent_sessions")
}

// ─────────────────────────────────────────
//  SUMMER: AGENT MESSAGES
// ─────────────────────────────────────────
model AgentMessage {
  id        String       @id @default(uuid())
  sessionId String       @map("session_id")
  role      String       // "user" | "assistant" | "system" | "tool"
  content   String       @db.Text
  toolCalls Json?        @map("tool_calls")     // Array of structured tool requests
  toolResult Json?       @map("tool_result")    // Tool output payload
  audioUrl  String?      @map("audio_url")      // Optional cached TTS snippet URL
  createdAt DateTime     @default(now()) @map("created_at")

  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}

// ─────────────────────────────────────────
//  SUMMER: HUMAN-IN-THE-LOOP APPROVALS
// ─────────────────────────────────────────
model AgentAction {
  id              String    @id @default(uuid())
  sessionId       String    @map("session_id")
  toolName        String    @map("tool_name")
  parameters      Json
  riskTier        String    @default("TIER_2") @map("risk_tier") // TIER_1, TIER_2, TIER_3
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED, BLOCKED
  decisionBy      String?   @map("decision_by") // User ID
  decidedAt       DateTime? @map("decided_at")
  executionResult Json?     @map("execution_result")
  createdAt       DateTime  @default(now()) @map("created_at")

  session         AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("agent_actions")
}


