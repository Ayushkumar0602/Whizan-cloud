{
  "name": "@whizan/storage-js",
  "version": "1.0.0",
  "description": "Whizan Cloud Storage JavaScript/TypeScript Client SDK — S3-compatible, ultra-fast file storage with Supabase parity",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "keywords": [
    "whizan",
    "storage",
    "s3",
    "object-storage",
    "cloud-storage",
    "supabase-parity",
    "sdk",
    "cloudflare-r2"
  ],
  "author": "Whizan Cloud Services",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ayushkumar0602/Whizan-cloud.git",
    "directory": "packages/storage-js"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "typescript": "^5.5.4"
  }
}
